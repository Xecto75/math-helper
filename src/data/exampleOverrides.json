    {
      "title": "The Correlation Coefficient r",
      "id": "lb132",
      "layout": "text-grid",
      "steps": [
        {
          "id": "lb133",
          "funcId": "text-create",
          "inputs": {
            "boxId": "formula",
            "title": "Coefficient r",
            "content": "$r = \\dfrac{\\sum (x_i-\\bar{x})(y_i-\\bar{y})}{\\sqrt{\\sum(x_i-\\bar{x})^2 \\sum (y_i-\\bar{y})^2}}$|$r$ is always between $-1$ and $1$.",
            "isList": "true"
          }
        },
        {
          "id": "lb134",
          "funcId": "text-create",
          "inputs": {
            "boxId": "interp",
            "title": "Interpretation",
