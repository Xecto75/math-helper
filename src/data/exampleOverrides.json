          }
        },
        {
          "id": "lb133",
          "funcId": "geo3d-label-sides",
          "inputs": {
            "id": "tri",
            "labels": "a,b,c"
          }
        },
        {
          "id": "lb134",
          "funcId": "geo3d-highlight-edge",
          "inputs": {
            "id": "tri",
            "edgeIndex": "0",
            "color": "orange"
          }
        },
        {
          "id": "lb135",
          "funcId": "geo3d-highlight-edge",
          "inputs": {
            "id": "tri",
            "edgeIndex": "1",
            "color": "green"
          }
        },
        {
          "id": "lb136",
          "funcId": "geo3d-highlight-edge",
          "inputs": {
            "id": "tri",
            "edgeIndex": "2",
            "color": "purple"
          }
        },
        {
          "id": "lb137",
          "funcId": "eq-create",
          "inputs": {
            "eq": "|a|{green}^2 + |b|{orange}^2 = |c|{purple}^2"
          }
        },
        {
          "id": "lb1",
          "funcId": "geo3d-label-sides",
          "inputs": {
            "id": "tri",
            "labels": "3,4,?"
          }
        },
        {
          "id": "lb139",
          "funcId": "eq-replace-variable",
          "inputs": {
