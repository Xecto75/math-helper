  "pythagoras": [
    {
      "title": "a² + b² = c²",
      "id": "lb130",
      "layout": "geo-equation",
      "steps": [
        {
          "id": "lb131",
          "funcId": "geo3d-create-2d",
          "inputs": {
            "id": "tri",
            "type": "right-triangle",
            "a": "3",
            "b": "4",
