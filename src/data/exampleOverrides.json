        },
        {
          "id": "lb129",
          "funcId": "cmt-free",
          "inputs": {
            "cmtId": "",
            "title": "Area of Trapezoid",
            "text": "$A = \\dfrac{(B + b) \\cdot h}{2}$",
            "side": "right",
            "color": ""
          }
        },
        {
          "id": "lb130",
          "funcId": "geo-show-area-measures",
          "inputs": {
            "shapeId": "trap",
            "color": ""
          }
        },
        {
          "id": "lb131",
          "funcId": "eq-create",
          "inputs": {
            "eq": "|A| = (|B| + |b|) * |h| / 2"
          }
        },
        {
          "id": "lb132",
          "funcId": "eq-replace-variable",
          "inputs": {
            "var_B": "6",
