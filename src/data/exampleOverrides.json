  "substitution": [
    {
      "title": "What is Substitution",
      "id": "lb562",
      "layout": "text-graph",
      "background": "default",
      "steps": [
        {
          "id": "lb563",
          "funcId": "graph-plot-function",
          "inputs": {
            "expr": "y=-x+3",
            "id": "f",
            "hideLabel": "0"
          }
        },
        {
          "id": "lb564",
          "funcId": "graph-plot-function",
          "inputs": {
            "expr": "-6x+3y=12",
            "id": "g",
            "hideLabel": "0"
          }
        },
        {
          "id": "lb565",
          "funcId": "text-create",
          "inputs": {
            "boxId": "box0",
            "title": "Substitution Method",
            "content": "How do you find the intersection point between the two functions ?|One way is the **Substition method**.",
            "isList": "false",
            "color": ""
          }
        },
        {
          "id": "lb566",
          "funcId": "text-create",
          "inputs": {
            "boxId": "box1",
            "title": "Step by Step",
            "content": "Isolate one of the equation into y = ax + b|Replace y in the second equation with it|Isolate x to find it's value|Replace x in either eqaution|Isolate y to find it's value|You get the intersection point (x,y) !",
            "isList": "steps",
            "color": ""
          }
        }
      ]
    },
    {
      "title": "Example of Substitution",
      "id": "lb567",
      "layout": "text-equation",
      "background": "default",
      "steps": [
        {
          "id": "lb568",
          "funcId": "text-create",
          "inputs": {
            "boxId": "box0",
            "title": "Two equations",
            "content": "$y=-x+3$|$-6x+3y=12$",
            "isList": "true",
            "color": ""
          }
        },
        {
          "id": "lb569",
          "funcId": "text-create",
          "inputs": {
            "boxId": "box1",
            "title": "Step 1",
            "content": "Isolate y in the equation $y=-x+3$",
            "isList": "false",
            "color": ""
          }
        },
        {
          "id": "lb570",
          "funcId": "eq-create",
          "inputs": {
            "eq": "y=-x+3"
          }
        },
        {
          "id": "lb571",
          "funcId": "cmt-equation",
          "inputs": {
            "cmtId": "",
            "text": "y already isolated",
            "side": "both",
            "indices": "",
            "color": ""
          }
        },
        {
          "id": "lb572",
          "funcId": "text-create",
          "inputs": {
            "boxId": "box1",
            "title": "Step 2",
            "content": "Replace y in the second equation",
            "isList": "false",
            "color": ""
          }
        },
        {
          "id": "lb573",
          "funcId": "eq-create",
          "inputs": {
            "eq": "-6x+3(-x+3)=12"
          }
        },
        {
          "id": "lb574",
          "funcId": "text-create",
          "inputs": {
            "boxId": "box1",
            "title": "Step 3",
            "content": "Isolate x, to find it's value",
            "isList": "false",
            "color": ""
          }
        },
        {
          "id": "lb575",
          "funcId": "eq-full-solve",
          "inputs": {}
        },
        {
          "id": "lb576",
          "funcId": "eq-save-result",
          "inputs": {
            "name": "x"
          }
        },
        {
          "id": "lb577",
          "funcId": "cmt-equation",
          "inputs": {
            "cmtId": "1",
            "text": "x = [x]v",
            "side": "left",
            "indices": "",
            "color": "red"
          }
        },
        {
          "id": "lb578",
          "funcId": "text-create",
          "inputs": {
            "boxId": "box1",
            "title": "Step 4",
            "content": "Replace x in the first equation",
            "isList": "false",
            "color": ""
          }
        },
        {
          "id": "lb579",
          "funcId": "eq-create",
          "inputs": {
            "eq": "|y|=-|x|+3"
          }
        },
        {
          "id": "lb580",
          "funcId": "eq-replace-variable",
          "inputs": {
            "replacements": "a=2,b=-3,c=1",
            "var_x": "[x]v"
          }
        },
        {
          "id": "lb581",
          "funcId": "eq-full-solve",
          "inputs": {}
        },
        {
          "id": "lb582",
          "funcId": "eq-save-result",
          "inputs": {
            "name": "y"
          }
        },
        {
          "id": "lb583",
          "funcId": "cmt-equation",
          "inputs": {
            "cmtId": "2",
            "text": "y = [y]v",
            "side": "left",
            "indices": "",
            "color": "red"
          }
        },
        {
          "id": "lb584",
          "funcId": "set-layout",
          "inputs": {
            "mode": "single-graph"
          }
        }
      ]
