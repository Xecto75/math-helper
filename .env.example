# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API.
#
# The VITE_ ones are compiled into the browser bundle and are PUBLIC by design.
# That is fine for the anon key: row-level security decides what it can read.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Server-only. NEVER prefix these with VITE_ — that would ship them to every
# visitor. The service-role key bypasses row-level security entirely; treat it
# like a root password. If it leaks, rotate it in the dashboard immediately.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Plans ────────────────────────────────────────────────────────────────────
# Custom lessons a free account may generate per calendar month.
FREE_LESSON_LIMIT=3

# Comma-separated emails that get 'pro' without paying. Server-side only, and
# only ever compared against the email inside a Supabase-verified token, so it
# cannot be spoofed by typing someone else's address.
PREMIUM_EMAILS=Anthonyg7567@gmail.com
